---
import { link } from '../config';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
const projects = (await getCollection('projects', p => !p.data.draft && p.data.featured)).sort((a,b)=>a.data.order-b.data.order);
---
<div class="project-selector" data-selector>
  <div class="project-tabs" role="group" aria-label="Choose a featured project">{projects.map((p,i) => <a href={`#preview-${p.id}`} class:list={['project-tab', { selected: i === 0 }]} data-project={p.id}><span>{p.data.shortTitle}</span><small>{p.data.category}</small><span class="tab-indicator" aria-hidden="true">+</span></a>)}</div>
  <div class="project-previews">{projects.map((p,i) => <article class="project-preview" id={`preview-${p.id}`} data-preview={p.id} aria-labelledby={`title-${p.id}`}>
    <div class="preview-visual"><Image src={p.data.cover} alt={p.data.coverAlt} widths={[480,800,1200]} sizes="(max-width: 900px) 100vw, 60vw" format="webp" loading={i===0?'eager':'lazy'}/><span class="visual-caption">{p.data.demo ? 'Concept system · Illustrative interface' : p.data.category}</span></div>
    <div class="preview-copy"><div class="card-meta"><span>{p.data.system}</span>{p.data.demo && <span class="demo-label">Demo case study</span>}</div><h3 id={`title-${p.id}`}>{p.data.title}</h3><p>{p.data.summary}</p><div class="tool-tags">{p.data.tools.map(tool=><span>{tool}</span>)}</div><a class="text-link" href={link(`/works/${p.id}/`)}>Explore the case study <span class="link-plus" aria-hidden="true">+</span></a></div>
  </article>)}</div>
  <p class="sr-only" data-selector-status aria-live="polite" aria-atomic="true"></p>
</div>
<script>
  const selector = document.querySelector<HTMLElement>('[data-selector]');
  if (selector) {
    const links = [...selector.querySelectorAll<HTMLAnchorElement>('[data-project]')];
    const panels = [...selector.querySelectorAll<HTMLElement>('[data-preview]')];
    const status = selector.querySelector('[data-selector-status]');
    const activate = (id: string, announce = false) => {
      panels.forEach(panel => panel.hidden = panel.dataset.preview !== id);
      links.forEach(link => { const active = link.dataset.project === id; link.classList.toggle('selected', active); if (active) link.setAttribute('aria-current', 'true'); else link.removeAttribute('aria-current'); });
      if (announce && status) status.textContent = `${links.find(l => l.dataset.project === id)?.querySelector('span')?.textContent} preview selected.`;
    };
    if (links[0]) activate(links[0].dataset.project!);
    links.forEach((link,i) => {
      link.addEventListener('click', event => { event.preventDefault(); activate(link.dataset.project!, true); });
      link.addEventListener('keydown', event => {
        if (['ArrowDown','ArrowRight','ArrowUp','ArrowLeft','Home','End'].includes(event.key)) {
          event.preventDefault();
          const next = event.key==='Home'?0:event.key==='End'?links.length-1:(i+(['ArrowDown','ArrowRight'].includes(event.key)?1:-1)+links.length)%links.length;
          links[next].focus(); activate(links[next].dataset.project!, true);
        }
      });
    });
  }
</script>
