---
const { compact = false } = Astro.props;
---
<div class:list={['network', { compact }]}>
  <svg viewBox="0 0 550 430" role="img" aria-labelledby={compact ? 'compact-network-title' : 'network-title'}>
    <title id={compact ? 'compact-network-title' : 'network-title'}>Forms, CRM, data, and AI connected through a central workflow</title>
    <defs><pattern id={compact ? 'dots-small' : 'dots'} x="0" y="0" width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="#2b3c4a"/></pattern></defs>
    <rect width="550" height="430" fill={compact ? 'url(#dots-small)' : 'url(#dots)'} />
    <g fill="none" stroke="#334958" stroke-width="1.5">
      <circle cx="275" cy="215" r="145" stroke-dasharray="3 7"/><circle cx="275" cy="215" r="77" stroke="#1e3943"/>
      <path d="M126 112h72q22 0 22 22v41q0 40 55 40m-149 97h72q22 0 22-22v-35q0-40 55-40m149-103h-72q-22 0-22 22v41q0 40-55 40m149 97h-72q-22 0-22-22v-35q0-40-55-40"/>
    </g>
    <g class="signal" fill="#65c9b5"><circle cx="220" cy="153" r="3"/><circle cx="330" cy="276" r="3"/><circle cx="169" cy="312" r="3"/></g>
    <rect x="237" y="177" width="76" height="76" rx="19" fill="#0c252e" stroke="#64c6b1"/>
    <g stroke="#8ee1cd" stroke-width="2" fill="none"><path d="m262 201 13 14-13 14m16-28 13 14-13 14"/></g>
    <g fill="#101f2d" stroke="#3c505d"><rect x="67" y="86" width="118" height="52" rx="9"/><rect x="365" y="86" width="118" height="52" rx="9"/><rect x="67" y="286" width="118" height="52" rx="9"/><rect x="365" y="286" width="118" height="52" rx="9"/></g>
    <g fill="#dfe7ed" font-family="sans-serif" font-size="14"><text x="111" y="117">Form</text><text x="410" y="117">CRM</text><text x="111" y="317">Data</text><text x="417" y="317">AI</text></g>
    <g stroke="#74c5b5" stroke-width="1.5" fill="none"><rect x="83" y="104" width="13" height="15" rx="2"/><path d="M86 109h7m-7 4h5"/><circle cx="389" cy="108" r="4"/><path d="M382 120q7-10 14 0"/><ellipse cx="89" cy="306" rx="7" ry="3"/><path d="M82 306v11q7 6 14 0v-11m-14 5q7 6 14 0"/><path d="m390 302 3 6 6 3-6 3-3 6-3-6-6-3 6-3Z"/></g>
    <g fill="#91a4b2" font-family="monospace" font-size="10" letter-spacing="1.5"><text x="227" y="46">LESS FRICTION</text><text x="220" y="393">MORE CONNECTION</text></g>
  </svg>
  <span class="network-caption"><span></span> Good systems work together.</span>
</div>
