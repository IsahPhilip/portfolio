---
import { link } from '../config';
import { site, contactHref } from '../config';
import Icon from './Icon.astro';
---
<footer class="site-footer" id="contact">
  <div class="wrap">
    <div class="contact-top"><p class="eyebrow">A better way to work</p><span class="footer-note">Human-first. System-minded.</span></div>
    <div class="contact-main"><h2>Let’s make your<br/>tools <em>work together.</em></h2><a class="button button-light" href={contactHref}><Icon name="mail"/> Start a conversation</a></div>
    <div class="contact-links"><a href={`mailto:${site.email}`}>{site.email}</a><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span class="sr-only">(opens in a new tab)</span></a>{site.github && <a href={site.github}>GitHub</a>}</div>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} {site.name}</span><p>Built with intention. Connected by design.</p><nav aria-label="Footer navigation"><a href={link('/')}>Home</a><a href={link('/works/')}>Works</a><a href={link('/about/')}>About</a></nav></div>
  </div>
</footer>
