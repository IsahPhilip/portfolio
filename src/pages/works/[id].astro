---
import { link } from '../../config';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ProjectCard from '../../components/ProjectCard.astro';
export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', p => !p.data.draft);
  return projects.map(project=>({params:{id:project.id},props:{project}}));
}) satisfies GetStaticPaths;
const { project } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const { Content, headings } = await render(project);
const p = project.data;
const related = (await getCollection('projects', entry => !entry.data.draft && entry.id!==project.id)).sort((a,b)=>a.data.order-b.data.order).slice(0,2);
---
<Base title={p.title} description={p.summary} article>
  <section class="case-intro dark"><div class="wrap"><a class="breadcrumb" href={link('/works/')}>Works / {p.category}</a><div class="case-title-grid"><div><p class="eyebrow">{p.demo?'Demo case study':'Case study'}</p><h1>{p.title}</h1><p>{p.summary}</p></div><dl><div><dt>System</dt><dd>{p.system}</dd></div><div><dt>Tools explored</dt><dd>{p.tools.join(' · ')}</dd></div><div><dt>Project status</dt><dd>{p.demo?'Concept architecture':'Published project'}</dd></div></dl></div></div></section>
  <div class="case-cover wrap"><Image src={p.cover} alt={p.coverAlt} widths={[480,900,1440]} sizes="(max-width: 1279px) 100vw, 1280px" loading="eager" format="webp"/><p>{p.demo?'Illustrative system interface. Synthetic data only.':p.coverAlt}</p></div>
  <div class="case-layout wrap"><TableOfContents headings={headings}/><div><div class="case-demo-note">{p.demo && <p><strong>A demonstration, with the details.</strong> This is a proposed system design, not a client engagement. Implementation steps and test cases are illustrative; no production deployment, measured outcomes, or testimonials are claimed.</p>}</div><article class="prose"><Content/></article><div class="case-end"><span>End of case study</span><a class="text-link" href={link('/works/')}>Back to all work <span class="link-plus" aria-hidden="true">+</span></a></div></div></div>
  <section class="section work-section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Keep exploring</p><h2>Other connections.</h2></div></div><div class="project-grid">{related.map(project=><ProjectCard project={project}/>)}</div></div></section>
</Base>
